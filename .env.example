# LLM
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Use OpenAI-compatible:
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1

# Use Gemini:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

DATABASE_URL=postgresql+asyncpg://eventos:eventos@localhost:5432/eventos
REDIS_URL=redis://localhost:6379/0
# Optional live web search (Brave). Weather (Open-Meteo), FX (Frankfurter),
# and venue/vendor places (OpenStreetMap) work without a key when USE_MOCK_TOOLS=false.
SEARCH_API_KEY=
USE_MOCK_TOOLS=true
MAX_ITERATIONS=5
DEBUG=false
CORS_ORIGINS=*
